# Copy this file to .env and adjust. .env is git-ignored.
ENV=local
SOURCE_MODE=file
INPUT_WORKBOOK=data/raw/03_PulseIQ_Analytics_Star_Schema_Dataset.xlsx
# Fixed reporting date (workbook cut-off) used for tenure. Never "today".
DEMO_TODAY=2026-09-30
# Strict by default: any rejected row fails the run and publishes nothing.
ALLOW_REJECTS=false

POSTGRES_DB=pulseiq
POSTGRES_USER=pulseiq
POSTGRES_PASSWORD=change_me_locally
# Python code connects with this URL. Use the same user, password and database as above.
DATABASE_URL=postgresql+psycopg://pulseiq:change_me_locally@db:5432/pulseiq

SUPERSET_SECRET_KEY=generate_with_openssl_rand_base64_42
SUPERSET_ADMIN_PASSWORD=choose_locally
SUPERSET_RO_PASSWORD=choose-a-password
